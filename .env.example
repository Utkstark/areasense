# === Server-only secrets — NEVER prefix with NEXT_PUBLIC_ ===

# Google Maps Platform (Geocoding + Distance Matrix + Places).
# Restrict by API + by IP/referrer in the Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Mapbox secret token — used server-side for the Isochrone API.
# Get one from https://account.mapbox.com/access-tokens/
# (Mapbox calls these "secret access tokens" — distinct from the public token below.)
MAPBOX_SECRET_TOKEN=

# === Client-exposed — intentionally public ===

# Mapbox public token — used by Mapbox GL JS in the browser for map tile rendering.
# Restrict to your production domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# === Optional ===

# Local dev only; never set in production.
DEBUG_LOG_API_CALLS=false

# Local dev convenience — when true, /lib/distance-matrix.ts short-circuits to
# deterministic haversine-based estimates and skips real Google API calls.
# Useful while iterating on the orchestrator. Leave unset (or false) in production.
DISTANCE_MATRIX_MOCK=false

PLACES_MOCK=false              # if true, /lib/places-nearby.ts returns synthetic
                                # stations and skips the live Google Places call.
                                # Useful for offline iteration; never set in prod.